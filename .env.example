# .env.example
# This is a fully static HTML/CSS/JS site with NO server-side code,
# NO database, and NO required runtime environment variables.
# The variables below are OPTIONAL and only relevant if you extend
# the site later (analytics, forms, contact-form backend, etc).

# ---- Optional: only if you wire up analytics on the pages ----
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- Optional: only if contact.html posts to a form backend (e.g. Formspree) ----
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# ---- Optional: used only in docker-compose.yml for container timezone ----
# TZ=UTC

# ---- Required by GitHub Actions (set as a REPO SECRET, not here) ----
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxxxxxx?key=xxxxxxxx